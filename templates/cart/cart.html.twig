{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h2>Votre panier</h2>
    {% if cart is not null  and cart.productOrders|length > 0 %}
    <ul>
        {% for productOrder in cart.productOrders %}
            <li>
                {{ productOrder.product.name }} - {{ productOrder.quantity }} x {{ productOrder.product.price }}€
            </li>
        {% endfor %}
    </ul>
    <!--<p>Total : {{ cart.getTotalPrice() }} €</p>-->
    {% else %}
        <p>Votre panier est vide</p>
    {% endif %}
{% endblock %}