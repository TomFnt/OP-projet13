{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h2>Votre panier</h2>
    {% if cart is not null  and cart.productOrders|length > 0 %}
    <ul>
        {% for productOrder in cart.productOrders %}
            <li>
                <p>{{ productOrder.product.name }} - <a href="{{  path('product_index', {'id': productOrder.product.id}) }}">{{ productOrder.quantity }}</a> x {{ productOrder.product.price }}€ </p>
            </li>
        {% endfor %}
    </ul>
    <!--<p>Total : {{ cart.getTotalPrice() }} €</p>-->
    {% else %}
        <p>Votre panier est vide</p>
    {% endif %}
{% endblock %}