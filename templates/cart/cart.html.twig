{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
<div class="cart-container">
        <h2>Mon panier</h2>

    {% if cart is not null  and cart.productOrders|length > 0 %}
        <div class="cart-block">
            <a href="{{ path("cart_clear_all") }}">
                <i class="fas fa-times"></i>
                    Vider le panier
            </a>
        {% for productOrder in cart.productOrders %}
            <div class="cart-row product-row">
                <div class="product-row-image">
                    <img src="{{ asset('img/products/' ~ productOrder.product.picture) }}" alt="{{ productOrder.product.name }}">
                </div>
                <div class="product-row-summary">
                    <p><b>{{ productOrder.product.name }}</b></p>
                    <p>Quantité : <a href="{{  path('product_index', {'id': productOrder.product.id}) }}">{{ productOrder.quantity }}</a></p>
                    <p>{{ productOrder.product.price }}€</p>
                </div>
            </div>
        {% endfor %}
    </ul>
            <div class="cart-row price-row">
                <p><b> Total : {{ cart.getTotalPrice() }} € </b></p>
                <p><i>Frais de livraison : Offert </i></p>
            </div>
            <a href="{{ path("validate_order") }}" class="btn order-btn"> Commander </a>
        </div>
    {% else %}
        <p>Votre panier est vide</p>
    {% endif %}
</div>
{% endblock %}



